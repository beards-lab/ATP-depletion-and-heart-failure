# params/: fitted snapshots (<tag>_opt.m, <tag>_seed.m, ...) are the model's parametrization
# and ARE tracked. Only the optimiser's exploratory iterations stay out (#72): the per-run
# galleries <tag>_iter/ and the numbered dumps <tag>_iter_<n>.m. An iteration a script
# loads is kept with `git add -f` (e.g. refit7_iter/refit7_iter_001.m).
/params/*_iter/
/params/*_iter_[0-9].m
/params/*_iter_[0-9][0-9].m
/params/*_iter_[0-9][0-9][0-9].m
/Analysis/batch_output_extracted_v1
data/
*.fig

# --- Reorganization additions (2026-06-16) ---
*.mexw64
_archive/
tools/*.exe
/resources/
*.log
*.err
*.bak

# Analyses: results/ is regenerable output and is never committed; figures/ holds the
# figures a report shows and is always committed, whatever the file type (#72).
/Analyses/*/results/
/Organ/Tests/results/
!/Analyses/*/figures/
!/Analyses/*/figures/**
